 func can_detect_unit(owner_id: int, enemy: RtsUnit) -> bool:
 	if not active: return true
 	if not can_see(owner_id, enemy.position): return false
-	if enemy.owner_id == owner_id or enemy.revealed_timer > 0.0: return true
